\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeAbisha}%
  [2026/11/01 v1.0.0 Abisha: a clean beamer theme for lectures and talks]

\mode<presentation>

%% ---------------------------------------------------------------------------
%% Options
%% ---------------------------------------------------------------------------
%% Boadilla already draws a footer with the author, the short title and the
%% frame number. \usetheme[nofootline]{Abisha} removes it, which buys back a
%% little vertical space on very dense slides.
\newif\ifabisha@nofootline
\abisha@nofootlinefalse
\DeclareOptionBeamer{nofootline}{\abisha@nofootlinetrue}
\ProcessOptionsBeamer

%% ---------------------------------------------------------------------------
%% Base look
%% ---------------------------------------------------------------------------
\usetheme{Boadilla}
\usecolortheme{beaver}
\usefonttheme{serif}

% No navigation symbols: the footer (if enabled) carries the progress instead.
\setbeamertemplate{navigation symbols}{}

% Justified body text; opt out in a deck with \raggedright if you prefer it.
\RequirePackage{ragged2e}
\justifying

%% ---------------------------------------------------------------------------
%% Blocks
%% ---------------------------------------------------------------------------
% Boadilla's `rose' colour theme paints the default `block' in the red
% `structure' tint. Restyle it to match the green `example' block instead.
\setbeamercolor{block title}{use=example text,fg=example text.fg,bg=example text.fg!20!bg}
\setbeamercolor{block body}{parent=normal text,use=block title,bg=block title.bg!50!bg}

%% ---------------------------------------------------------------------------
%% Logo helper
%% ---------------------------------------------------------------------------
%% \abishalogo[width]{path} puts a logo on the title page. The file is looked
%% up at compile time, so a clone without a logo still compiles; you only get
%% a warning when the file is missing.
%%
%%     \abishalogo{images/logo.png}
%%     \abishalogo[2.2cm]{images/logo.png}
\newcommand{\abishalogo}[2][1.6cm]{%
  \IfFileExists{#2}%
    {\titlegraphic{\includegraphics[width=#1]{#2}}}%
    {\PackageWarning{beamerthemeAbisha}%
       {Logo `#2' not found, so no title graphic is drawn}}%
}

%% ---------------------------------------------------------------------------
%% Optional removal of the footer
%% ---------------------------------------------------------------------------
\ifabisha@nofootline
  \setbeamertemplate{footline}{}
\fi

\mode<all>
\endinput
