\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeAbisha}%
  [2026/11/01 v1.0.0 Abisha: a clean beamer theme for lectures and talks]

\mode<presentation>

%% ---------------------------------------------------------------------------
%% Options
%% ---------------------------------------------------------------------------
%% Boadilla already draws a footer with the author, the short title and the
%% frame number. \usetheme[nofootline]{Abisha} removes it, which buys back a
%% little vertical space on very dense slides.
\newif\ifabisha@nofootline
\abisha@nofootlinefalse
\DeclareOptionBeamer{nofootline}{\abisha@nofootlinetrue}
\ProcessOptionsBeamer

%% ---------------------------------------------------------------------------
%% Base look
%% ---------------------------------------------------------------------------
\usetheme{Boadilla}
\usecolortheme{beaver}
\usefonttheme{serif}

% No navigation symbols: the footer (if enabled) carries the progress instead.
\setbeamertemplate{navigation symbols}{}

% Justified body text; opt out in a deck with \raggedright if you prefer it.
\RequirePackage{ragged2e}
\justifying

%% ---------------------------------------------------------------------------
%% Fonts and Colors
%% ---------------------------------------------------------------------------
% The cover page title is bold by default in the AKM format.
\setbeamerfont{title}{series=\bfseries}

% Institute text defaults to purple, matching the AKM cover formatting.
\definecolor{abishapurple}{named}{purple}
\setbeamercolor{institute}{fg=abishapurple}

%% ---------------------------------------------------------------------------
%% Blocks
%% ---------------------------------------------------------------------------
% Boadilla's `rose' colour theme paints the default `block' in the red
% `structure' tint. Give it a distinct muted-plum colour instead, so the three
% block kinds read as: block (plum), exampleblock (green), alertblock (red).
\definecolor{abishaplum}{RGB}{96,45,118}
\setbeamercolor{block title}{fg=abishaplum,bg=abishaplum!20!bg}
\setbeamercolor{block body}{parent=normal text,use=block title,bg=block title.bg!50!bg}

%% ---------------------------------------------------------------------------
%% Logo helper and Title Page
%% ---------------------------------------------------------------------------
%% \abishalogo[width]{path} sets a logo on the title page, placed between the
%% author and the institute text, exactly as formatted in the AKM lecture deck.
\newcommand{\abishalogo}[2][1.6cm]{%
  \gdef\abisha@logo@path{#2}%
  \gdef\abisha@logo@width{#1}%
}

\setbeamertemplate{institute}{%
  \begin{beamercolorbox}[sep=8pt,center,colsep=-4bp,rounded=true,shadow=\beamer@themerounded@shadow]{institute}%
    \usebeamerfont{institute}%
    \ifx\abisha@logo@path\@undefined\else%
      \IfFileExists{\abisha@logo@path}{%
        \includegraphics[width=\abisha@logo@width]{\abisha@logo@path}\medskip\\%
      }{%
        \PackageWarning{beamerthemeAbisha}{Logo `\abisha@logo@path' not found}%
      }%
    \fi%
    \insertinstitute\par%
  \end{beamercolorbox}%
}

%% ---------------------------------------------------------------------------
%% Optional removal of the footer
%% ---------------------------------------------------------------------------
\ifabisha@nofootline
  \setbeamertemplate{footline}{}
\fi

\mode<all>
\endinput
